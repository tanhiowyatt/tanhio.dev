# GitHub API Token (Optional: enables GitHub commits & contributions section)
GITHUB_TOKEN=your_github_token_here

# Discord User ID for presence widget (Optional: falls back to default ID)
DISCORD_USER_ID=your_discord_user_id_here

# PostHog Analytics
INSIGHTS_TEST_MODE=true
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_public_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
POSTHOG_API_KEY=your_posthog_api_key_here

# Discord webhook that receives component suggestions (Required for the suggest dialog on /components)
DISCORD_COMPONENT_SUGGESTION_WEBHOOK_URL=

# TON Connect payments
TON_CENTER_API_URL=https://toncenter.com/api/v3
TON_CENTER_API_KEY=your_ton_center_api_key_here
TON_OWNER_ADDRESS=tanhiowyatt.ton
