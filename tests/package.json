{
  "name": "site-tests",
  "version": "1.0.0",
  "description": "Test suite for tanhiowyatt website",
  "scripts": {
    "test": "jest tests/unit tests/integration tests/security tests/a11y",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test || echo 'Playwright browsers not installed. Run: ./node_modules/.bin/playwright install'",
    "test:security": "jest tests/security",
    "test:a11y": "jest tests/a11y",
    "test:all": "jest tests/unit tests/integration tests/security tests/a11y",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "playwright:install": "./node_modules/.bin/playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "9.3.4",
    "@testing-library/jest-dom": "6.1.5",
    "@testing-library/user-event": "14.5.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "23.0.1"
  },
  "jest": {
    "rootDir": "../",
    "roots": [
      "<rootDir>/tests",
      "<rootDir>/sites/shared/assets"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "<rootDir>/sites/shared/assets/**/*.js",
      "!<rootDir>/sites/shared/assets/**/*.test.js",
      "!<rootDir>/sites/shared/assets/vendor/**",
      "!<rootDir>/sites/shared/assets/components/map.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "moduleNameMapper": {
      "^assets/(.*)$": "<rootDir>/sites/shared/assets/$1"
    }
  }
}
